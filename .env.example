# Copy to .env for local overrides (all optional in development).

# Canonical origin for <link rel="canonical"> and the sitemap (build tooling).
SITE_URL=https://example.com

# Production only — enables the /keystatic admin to commit via a GitHub App.
# The repo is public config (hence PUBLIC_); the rest are secrets from the
# Keystatic setup flow at /keystatic.
# PUBLIC_KEYSTATIC_GITHUB_REPO=your-user/your-repo
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
