---
import type { CVSectionData } from '../lib/content';

interface Props {
  section: CVSectionData;
}

const { section } = Astro.props;
---

<section class="cv-section">
  <h2>{section.label}</h2>
  <ul>
    {
      section.entries.map((entry) => (
        <li>
          <div class="period">{entry.period}</div>
          <div class="detail">
            <p class="headline">
              {entry.title}
              {entry.title && entry.organization && <span class="sep">·</span>}
              {entry.organization && <span class="org">{entry.organization}</span>}
            </p>
            {entry.note && <p class="note">{entry.note}</p>}
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .cv-section {
    margin-bottom: var(--space-7);
  }

  .cv-section h2 {
    font-size: var(--text-lg);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-border-strong);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .period {
    font-size: var(--text-sm);
    color: var(--color-text-faint);
    padding-top: 0.15rem;
  }

  .headline {
    margin: 0;
    font-size: var(--text-base);
  }

  .headline .sep {
    margin: 0 0.5ch;
    color: var(--color-text-faint);
  }

  .org {
    color: var(--color-text-soft);
  }

  .note {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  @media (max-width: 34rem) {
    li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
